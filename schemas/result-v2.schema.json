{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWM node/run result v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "node_id",
    "parent_id",
    "cycle",
    "invocation_id",
    "status",
    "updated_at",
    "exit_code"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "invocation_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "waiting_children",
        "completed",
        "executor_failed",
        "child_failed",
        "invalid_delivery",
        "budget_exhausted",
        "interrupted"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "delivery_sha256"
        ],
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}
