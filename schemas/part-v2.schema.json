{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWM node delivery v2",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "parent_id",
    "module",
    "export",
    "children",
    "account",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "module": {
      "type": "string",
      "pattern": "\\.(js|mjs)$"
    },
    "export": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "children": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
      }
    },
    "account": {
      "const": "account.md"
    },
    "outputs": {
      "const": {
        "final": "outputs/final.png",
        "comparison": "outputs/comparison.png",
        "overlay": "outputs/overlay.png",
        "compass": [
          "outputs/compass/000.png",
          "outputs/compass/090.png",
          "outputs/compass/180.png",
          "outputs/compass/270.png"
        ]
      }
    },
    "viewer": {
      "const": "index.html"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "node_id": {
            "const": "scene"
          }
        }
      },
      "then": {
        "required": [
          "viewer"
        ],
        "properties": {
          "parent_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
          }
        }
      }
    }
  ]
}
